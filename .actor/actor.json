{
    "actorSpecification": 1,
    "name": "email-verifier-pro",
    "title": "Email Verifier & Validator (No API Key Required)",
    "description": "Bulk verify and validate email lists to improve deliverability and reduce bounce rates. Includes SMTP, MX, and Catch-all checks. No external API key required.",
    "seoTitle": "Email Verifier & Validator: Bulk Validate Emails",
    "seoDescription": "Bulk verify and validate email lists to improve deliverability and reduce bounce rates. Includes SMTP, MX, and Catch-all checks. No external API key required.",
    "version": "1.0",
    "buildTag": "latest",
    "input": "./input_schema.json",
    "output": "./output_schema.json",
    "dockerfile": "./Dockerfile",
    "readme": "../README.md",
    "categories": ["LEAD_GENERATION", "MARKETING", "BUSINESS"],
    "pricingModel": {
        "pricingType": "PAY_PER_EVENT",
        "pricePerEvent": {
            "email-verified": {
                "eventTitle": "Email verified",
                "eventDescription": "Charged for each email address verified via SMTP",
                "eventPriceUsd": 0.00075
            }
        }
    },
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Verified Emails",
            "views": {
                "overview": {
                    "title": "Verification Results",
                    "transformation": {
                        "fields": [
                            "email",
                            "status",
                            "is_disposable",
                            "is_role_based",
                            "is_catch_all",
                            "is_free_provider",
                            "mx_host",
                            "smtp_response",
                            "verified_at"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "email": {
                                "label": "Email Address",
                                "format": "text"
                            },
                            "status": {
                                "label": "Status",
                                "format": "text"
                            },
                            "is_disposable": {
                                "label": "Disposable",
                                "format": "boolean"
                            },
                            "is_role_based": {
                                "label": "Role-Based",
                                "format": "boolean"
                            },
                            "is_catch_all": {
                                "label": "Catch-All",
                                "format": "boolean"
                            },
                            "is_free_provider": {
                                "label": "Free Provider",
                                "format": "boolean"
                            },
                            "mx_host": {
                                "label": "MX Host",
                                "format": "text"
                            },
                            "smtp_response": {
                                "label": "SMTP Response",
                                "format": "text"
                            },
                            "verified_at": {
                                "label": "Verified At",
                                "format": "text"
                            }
                        }
                    }
                }
            }
        }
    }
}
